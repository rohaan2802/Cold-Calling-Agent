# ===========================================
# Cold-Calling AI Voice Agent — Environment
# Copy this file to .env and fill in your keys
# ===========================================

# VAPI (Required — free $10 credits, no card) — https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_assistant_id_after_creation
VAPI_PHONE_NUMBER_ID=your_phone_number_id_from_vapi_dashboard

# Groq (Required — 100% free AI) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# App / Deployment (Vercel — free tier)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id_after_creation
APP_URL=https://your-deployed-app.vercel.app
NODE_ENV=development
